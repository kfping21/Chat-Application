{
  "name": "treehole-backend",
  "version": "0.1.0",
  "description": "Minimal backend for Treehole chat app",
  "main": "app/index.js",
  "scripts": {
    "start": "node app/index.js",
    "dev": "node app/index.js",
    "test": "node --test --test-concurrency=1 tests",
    "test:coverage": "c8 --reporter=text --reporter=lcov --reporter=cobertura --all --include=app/routes/store/authStore.js --include=app/routes/utils/responseUtils.js node --test tests/unit.authStore.test.js tests/unit.responseUtils.test.js",
    "test:coverage:ci": "npm run test:coverage && node -e \"require('fs').copyFileSync('coverage/cobertura-coverage.xml','coverage.xml')\""
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "mysql2": "^3.12.0",
    "ws": "^8.18.0"
  },
  "keywords": [
    "treehole",
    "chat",
    "backend"
  ],
  "author": "",
  "license": "MIT"
  ,
  "devDependencies": {
    "c8": "^10.1.2"
  }
}
