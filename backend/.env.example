# ===========================================
# 树洞应用 (TreeHole) 环境配置模板
# ===========================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填入实际的值（不要提交真实的密钥到版本库）
# ===========================================

# ========== 数据库配置 ==========
# MongoDB 连接字符串（包含用户名和密码）
# 后端优先读取 MONGO_URI
MONGO_URI=mongodb://hostname:27017/database
DATABASE_URL=mongodb://username:password@hostname:port/database?options

# ========== 服务器配置 ==========
PORT=3001

# ========== JWT 密钥（重要！） ==========
# 生产环境请使用强随机字符串，建议 32 位以上
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_change_in_production

# ========== Cloudinary 云存储（可选） ==========
# 如果不使用云存储头图，可以不填
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ========== 其他第三方服务密钥（按需添加） ==========
# OPENAI_API_KEY=your_openai_api_key
# SENDGRID_API_KEY=your_sendgrid_api_key

# ========== 开发环境备注 ==========
# 开发环境 JWT_SECRET 默认值: treehole_dev_secret_key_2024_do_not_use_in_production
# 生产环境务必更换为强密钥！
