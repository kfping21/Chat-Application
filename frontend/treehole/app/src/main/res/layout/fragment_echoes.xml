<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep"
    android:paddingBottom="80dp">

    <!-- Sticky Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_header"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:elevation="8dp">

        <!-- Title: 回响 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/title_echoes"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:textColor="@color/gold_primary"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <!-- Tabs: 评论 / 私聊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btn_tab_comments"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/tab_comments"
                android:textSize="14sp"
                android:background="@drawable/bg_chip_selected"
                android:textColor="@color/gold_primary" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp">

                <Button
                    android:id="@+id/btn_tab_messages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/tab_messages"
                    android:textSize="14sp"
                    android:background="@drawable/bg_chip_default"
                    android:textColor="@color/text_muted" />

                <!-- Unread badge -->
                <TextView
                    android:id="@+id/tv_unread_badge"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="2dp"
                    android:background="@color/unread_badge"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_echoes"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
