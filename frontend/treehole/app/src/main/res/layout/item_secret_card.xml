<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="16dp">

    <!-- Header row: mood tag + time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tv_card_mood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="孤独"
            android:textSize="11sp"
            android:textColor="@color/mood_lonely"
            android:background="@drawable/bg_chip_default"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_card_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2小时前"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <!-- Content -->
    <TextView
        android:id="@+id/tv_card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingMultiplier="1.7"
        android:letterSpacing="0.01"
        android:layout_marginBottom="16dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="12dp" />

    <!-- Actions row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Like -->
        <LinearLayout
            android:id="@+id/btn_card_like"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="24dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_action_heart_outline" />

            <TextView
                android:id="@+id/tv_card_likes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="234"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <!-- Comment -->
        <LinearLayout
            android:id="@+id/btn_card_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_action_comment_outline" />

            <TextView
                android:id="@+id/tv_card_comments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="45"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <!-- Share -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="end|top"
                android:background="@drawable/bg_avatar_golden"
                android:alpha="0.35" />

            <ImageButton
                android:id="@+id/btn_card_share"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@null"
                android:src="@android:drawable/ic_menu_share"
                app:tint="@color/text_secondary"
                android:contentDescription="分享" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
