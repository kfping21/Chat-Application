<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep"
    android:paddingBottom="80dp">

    <!-- Sticky Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_explore"
            android:textSize="24sp"
            android:textColor="@color/gold_primary"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_search_bar"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/text_muted" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="@string/hint_search"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp"
                android:inputType="text" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp">

            <!-- Hot Topics label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_hot_topics"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="12dp"
                android:paddingStart="4dp" />

            <!-- Popular Tags ScrollView -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:id="@+id/ll_tags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Orb Canvas area -->
            <FrameLayout
                android:id="@+id/fl_orb_canvas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="480dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_orb_container"
                android:clipChildren="false">

                <!-- Central Glow Tree -->
                <View
                    android:layout_width="120dp"
                    android:layout_height="160dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_tree_glow" />

                <!-- Decorative stars -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="72dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_avatar"
                    android:alpha="0.38" />
                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/bg_avatar"
                    android:alpha="0.34" />
                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="34dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_avatar"
                    android:alpha="0.28" />
                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="36dp"
                    android:layout_marginTop="42dp"
                    android:background="@drawable/bg_avatar"
                    android:alpha="0.30" />
                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="46dp"
                    android:layout_marginBottom="98dp"
                    android:background="@drawable/bg_avatar"
                    android:alpha="0.34" />
                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="66dp"
                    android:layout_marginBottom="118dp"
                    android:background="@drawable/bg_avatar"
                    android:alpha="0.28" />

                <!-- Placeholder Orbs to simulate design -->
                <View
                    android:id="@+id/orb_1"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="80dp"
                    android:layout_marginTop="60dp"
                    android:background="@drawable/bg_orb"
                    android:clickable="true"
                    android:backgroundTint="#60a5fa" />
                
                <View
                    android:id="@+id/orb_2"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="60dp"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/bg_orb"
                    android:clickable="true"
                    android:backgroundTint="#fbbf24" />

                <View
                    android:id="@+id/orb_3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_orb"
                    android:clickable="true"
                    android:backgroundTint="#34d399" />

                <View
                    android:id="@+id/orb_4"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="40dp"
                    android:background="@drawable/bg_orb"
                    android:clickable="true"
                    android:backgroundTint="#f472b6" />
                    
                <View
                    android:id="@+id/orb_5"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="50dp"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/bg_orb"
                    android:clickable="true"
                    android:backgroundTint="#a78bfa" />
                    
                <View
                    android:id="@+id/orb_6"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="60dp"
                    android:layout_marginBottom="80dp"
                    android:background="@drawable/bg_orb"
                    android:clickable="true"
                    android:backgroundTint="#8b5cf6" />
                    
                <View
                    android:id="@+id/orb_7"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="70dp"
                    android:layout_marginBottom="60dp"
                    android:background="@drawable/bg_orb"
                    android:clickable="true"
                    android:backgroundTint="#fbbf24" />

            </FrameLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
