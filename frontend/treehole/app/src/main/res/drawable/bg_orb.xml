<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer faint halo -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="40dp"
                android:startColor="#80FFFFFF"
                android:endColor="#1AFFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#B3FFFFFF" />
        </shape>
    </item>
    <!-- Inner bright core with margin to simulate sizing -->
    <item
        android:left="12dp"
        android:right="12dp"
        android:top="12dp"
        android:bottom="12dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="20dp"
                android:startColor="#B3FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
