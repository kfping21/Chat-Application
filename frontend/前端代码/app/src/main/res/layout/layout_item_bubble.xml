<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="8dp">

    <!-- Avatar Group (Avatar + Username) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal">

        <!-- Avatar with Selection Ring -->
        <FrameLayout
            android:id="@+id/fl_avatar_container"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/view_cyan_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_cyan_ring"
                android:visibility="gone" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                android:background="@drawable/bg_avatar_circle" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxWidth="80dp" />
    </LinearLayout>

    <!-- The status bubble -->
    <LinearLayout
        android:id="@+id/layout_bubble_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_bubble_card"
        android:padding="12dp"
        android:minWidth="140dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:maxWidth="200dp" />

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="刚刚"
            android:textColor="#88FFFFFF"
            android:textSize="10sp"
            android:layout_gravity="end" />
    </LinearLayout>
</LinearLayout>
