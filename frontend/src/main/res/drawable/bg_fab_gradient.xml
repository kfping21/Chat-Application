<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <!-- Enhanced gradient with inner glow -->
    <gradient
        android:angle="135"
        android:type="radial"
        android:centerX="0.3"
