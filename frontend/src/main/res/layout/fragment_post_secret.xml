<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep">

    <!-- Unified Page Header (Minimalist) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_deep"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <!-- Close button (X) -->
        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            android:padding="12dp"
            app:tint="@color/text_primary"
            android:contentDescription="关闭" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <!-- Top Right Publish Button -->
        <TextView
            android:id="@+id/btn_submit"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="发布"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/bg_deep"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_button_golden" />
    </LinearLayout>

    <!-- Content scrollable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Text area -->
            <EditText
                android:id="@+id/et_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:background="@null"
                android:hint="@string/hint_post_content"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.6"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:maxLength="500" />

            <!-- Add image button and preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                
                <ImageButton
                    android:id="@+id/btn_add_image"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_card"
                    android:src="@drawable/ic_action_add_image"
                    android:scaleType="centerInside"
                    android:padding="20dp"
                    app:tint="@color/text_muted"
                    android:contentDescription="添加图片" />
                    
                <LinearLayout
                    android:id="@+id/ll_image_previews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="12dp">
                    
                    <FrameLayout
                        android:id="@+id/fl_preview_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:layout_marginEnd="12dp">
                        <ImageView
                            android:id="@+id/iv_image_preview_1"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:scaleType="centerCrop"
                            android:clipToOutline="true"
                            android:background="@drawable/bg_card" />
                        <ImageView
                            android:id="@+id/btn_remove_image_1"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_close"
                            android:background="@drawable/bg_unread_badge"
                            app:tint="@android:color/white"
                            android:padding="2dp" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/fl_preview_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone">
                        <ImageView
                            android:id="@+id/iv_image_preview_2"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:scaleType="centerCrop"
                            android:clipToOutline="true"
                            android:background="@drawable/bg_card" />
                        <ImageView
                            android:id="@+id/btn_remove_image_2"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_close"
                            android:background="@drawable/bg_unread_badge"
                            app:tint="@android:color/white"
                            android:padding="2dp" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
            
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="8dp"/>

            <!-- AI Inspiration Section Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <!-- Default State -->
                <LinearLayout
                    android:id="@+id/ll_ai_default"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔗 试试AI帮你写文案"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/ai_accent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/btn_ai_inspiration"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/bg_ai_button_accent"
                        android:clickable="true"
                        android:focusable="true">
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🪄 Ai帮写"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/ai_accent" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Generating State -->
                <LinearLayout
                    android:id="@+id/ll_ai_generating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬 生成中 ···"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/ai_accent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/btn_ai_cancel"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/bg_ai_button_stop"
                        android:clickable="true"
                        android:focusable="true">
                            
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_pause"
                            app:tint="#FFFFA726" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="停止生成"
                            android:textSize="11sp"
                            android:textColor="#FFFFA726" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Generated State -->
                <LinearLayout
                    android:id="@+id/ll_ai_generated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔗 AI生成好了"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/ai_accent" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Action buttons -->
                    <TextView
                        android:id="@+id/btn_ai_optimize"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:text="✨ 优化Tips"
                        android:textSize="11sp"
                        android:textColor="#E5E7EB"
                        android:background="@drawable/bg_ai_button_gray"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/btn_ai_revoke"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:text="↺ 撤回"
                        android:textSize="11sp"
                        android:textColor="#E5E7EB"
                        android:background="@drawable/bg_ai_button_gray"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/btn_ai_regenerate"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:text="↻ 重新生成"
                        android:textSize="11sp"
                        android:textColor="#E5E7EB"
                        android:background="@drawable/bg_ai_button_gray"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />
                </LinearLayout>
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="16dp"/>

            <!-- Counter -->
            <TextView
                android:id="@+id/tv_char_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0/500"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:gravity="end"
                android:layout_marginBottom="12dp" />

            <!-- Mood selection label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:background="@color/gold_primary"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_choose_mood"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Mood RecyclerView (horizontal) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_moods"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:scrollbars="none"
                android:layout_marginBottom="16dp" />

            <!-- Allow Comments toggle row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_allow_comments"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <Switch
                    android:id="@+id/switch_allow_comments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="@color/gold_primary"
                    android:trackTint="@color/gold_dim" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
