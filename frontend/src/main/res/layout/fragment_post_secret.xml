<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep">

    <!-- Unified Page Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_header"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <!-- Close button -->
        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerInside"
            android:padding="12dp"
            app:tint="@color/text_secondary"
            android:contentDescription="关闭" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_post_secret"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/gold_primary"
            android:letterSpacing="0.05" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <!-- Spacer to balance close button -->
        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <!-- Content scrollable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Writing area - no card, just background -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:minHeight="200dp"
                android:layout_marginBottom="12dp">

                <!-- Text area -->
                <EditText
                    android:id="@+id/et_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="160dp"
                    android:background="@null"
                    android:hint="@string/hint_post_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.6"
                    android:inputType="textMultiLine"
                    android:gravity="top"
                    android:maxLength="500" />

                <!-- Image preview (hidden by default) -->
                <ImageView
                    android:id="@+id/iv_image_preview"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:background="@drawable/bg_card" />

                <!-- Counter + action row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tv_char_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0/500"
                        android:textSize="11sp"
                        android:textColor="@color/text_hint" />

                    <TextView
                        android:id="@+id/btn_voice"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:text="@string/btn_record"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/bg_chip_default"
                        android:layout_marginEnd="8dp" />

                    <ImageButton
                        android:id="@+id/btn_add_image"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_action_add_image"
                        android:scaleType="centerInside"
                        android:padding="4dp"
                        app:tint="@color/text_muted"
                        android:contentDescription="添加图片" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mood selection label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:background="@color/gold_primary"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_choose_mood"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Mood RecyclerView (horizontal) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_moods"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:scrollbars="none"
                android:layout_marginBottom="16dp" />

            <!-- Allow Comments toggle row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_allow_comments"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <Switch
                    android:id="@+id/switch_allow_comments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="@color/gold_primary"
                    android:trackTint="@color/gold_dim" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom submit button area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:background="@color/bg_header"
        android:elevation="8dp">

        <Button
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/btn_post"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bg_deep"
            android:background="@drawable/bg_button_golden" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/post_anonymous_tip"
            android:textSize="10sp"
            android:textColor="@color/text_hint" />
    </LinearLayout>

</LinearLayout>
