<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_header"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerInside"
            android:padding="12dp"
            app:tint="@color/text_secondary"
            android:contentDescription="返回" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <!-- Share button -->
        <ImageButton
            android:id="@+id/btn_share"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_action_share"
            android:scaleType="centerInside"
            android:padding="12dp"
            app:tint="@color/text_secondary"
            android:contentDescription="分享" />

        <!-- More options button for post actions -->
        <ImageButton
            android:id="@+id/btn_more_detail"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vertical"
            android:scaleType="centerInside"
            android:padding="12dp"
            app:tint="@color/text_secondary"
            android:visibility="gone"
            android:contentDescription="更多选项" />
    </LinearLayout>

    <!-- Scrollable content + comment input -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="@dimen/bottom_nav_height"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Secret Content - no card background -->
            <LinearLayout
                android:id="@+id/card_secret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp"
                android:layout_marginBottom="20dp">

                <!-- Header: avatar + username + mood + time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <!-- Avatar -->
                    <ImageView
                        android:id="@+id/iv_detail_avatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_launcher_foreground"
                        android:background="@drawable/bg_avatar_circle"
                        android:clipToOutline="true"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Username -->
                    <TextView
                        android:id="@+id/tv_detail_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="匿名用户"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary" />

                    <!-- Mood tag -->
                    <TextView
                        android:id="@+id/tv_detail_mood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="孤独"
                        android:textSize="11sp"
                        android:textColor="@color/mood_lonely"
                        android:background="@drawable/bg_chip_default"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp" />

                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                    <!-- Time -->
                    <TextView
                        android:id="@+id/tv_detail_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2小时前"
                        android:textSize="10sp"
                        android:textColor="@color/text_muted" />
                </LinearLayout>

                <!-- Content text -->
                <TextView
                    android:id="@+id/tv_detail_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.5"
                    android:letterSpacing="0.01"
                    android:layout_marginBottom="16dp" />

                <!-- Actions row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Like button -->
                    <LinearLayout
                        android:id="@+id/btn_like_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="4dp">

                        <ImageView
                            android:id="@+id/iv_like_icon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_action_heart_outline" />

                        <TextView
                            android:id="@+id/tv_like_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="234"
                            android:textSize="10sp"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>

                    <!-- Comment count -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="20dp"
                        android:padding="4dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_action_comment_outline" />

                        <TextView
                            android:id="@+id/tv_comment_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="45"
                            android:textSize="10sp"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>

                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                    <!-- Share button -->
                    <ImageButton
                        android:id="@+id/btn_share_detail"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:padding="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_action_share"
                        app:tint="@color/text_secondary"
                        android:contentDescription="分享" />
                </LinearLayout>
            </LinearLayout>

            <!-- Comments section title -->
            <TextView
                android:id="@+id/tv_echoes_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="回响 3"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp" />

            <!-- Comments RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_comments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:scrollbars="none" />

        </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/gold_primary" />

    </FrameLayout>

    <!-- Floating comment input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_header"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:elevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_comment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hint_comment"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp"
                android:singleLine="true"
                android:inputType="text" />

            <ImageButton
                android:id="@+id/btn_send_comment"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_action_send"
                app:tint="@color/gold_primary"
                android:contentDescription="发送" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
