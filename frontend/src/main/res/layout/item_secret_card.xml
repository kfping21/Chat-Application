<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/bg_deep"
    android:padding="16dp">

    <!-- Avatar -->
    <ImageView
        android:id="@+id/iv_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_launcher_foreground"
        android:background="@drawable/bg_avatar_circle"
        android:clipToOutline="true"
        android:layout_marginEnd="10dp" />

    <!-- Right Side Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <!-- Header row: username + mood + time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Username -->
            <TextView
                android:id="@+id/tv_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="匿名用户"
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/text_primary" />

            <!-- Mood tag -->
            <TextView
                android:id="@+id/tv_card_mood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="孤独"
                android:textSize="11sp"
                android:textColor="@color/mood_lonely"
                android:background="@drawable/bg_chip_default"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <!-- Time -->
            <TextView
                android:id="@+id/tv_card_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2小时前"
                android:textSize="10sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <!-- Content -->
        <TextView
            android:id="@+id/tv_card_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:lineSpacingMultiplier="1.5"
            android:letterSpacing="0.01"
            android:textStyle="normal"
            android:layout_marginBottom="12dp" />

        <!-- Post Images -->
        <LinearLayout
            android:id="@+id/ll_card_images"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_card_image_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_card"
                android:clipToOutline="true"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_card_image_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_card"
                android:clipToOutline="true"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Interactive bottom row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp">

            <!-- Like button -->
            <LinearLayout
                android:id="@+id/btn_card_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/iv_like_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_action_heart_outline"
                    app:tint="@color/text_muted" />

                <TextView
                    android:id="@+id/tv_card_likes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="0"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Comment button -->
            <LinearLayout
                android:id="@+id/btn_card_comment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackground"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_action_comment_outline"
                    app:tint="@color/text_muted" />

                <TextView
                    android:id="@+id/tv_card_comments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="0"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <!-- Share icon -->
            <ImageView
                android:id="@+id/btn_card_share"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_action_share"
                app:tint="@color/text_muted"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- Delete icon -->
            <ImageView
                android:id="@+id/btn_card_delete"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/text_muted"
                android:visibility="gone"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
