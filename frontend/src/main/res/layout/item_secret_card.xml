<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_deep"
    android:padding="16dp">

    <!-- Header row: avatar + username + time + mood -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <!-- Avatar -->
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_launcher_foreground"
            android:background="@drawable/bg_avatar_circle"
            android:clipToOutline="true"
            android:layout_marginEnd="10dp" />

        <!-- Username -->
        <TextView
            android:id="@+id/tv_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="匿名用户"
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/text_primary" />

        <!-- Mood tag -->
        <TextView
            android:id="@+id/tv_card_mood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="孤独"
            android:textSize="11sp"
            android:textColor="@color/mood_lonely"
            android:background="@drawable/bg_chip_default"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <!-- Time -->
        <TextView
            android:id="@+id/tv_card_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2小时前"
            android:textSize="10sp"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <!-- Content -->
    <TextView
        android:id="@+id/tv_card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:lineSpacingMultiplier="1.5"
        android:letterSpacing="0.01"
        android:textStyle="normal"
        android:layout_marginBottom="12dp" />

    <!-- Actions row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <!-- Like -->
        <LinearLayout
            android:id="@+id/btn_card_like"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="20dp"
            android:padding="4dp">

            <ImageView
                android:id="@+id/iv_like_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_action_heart_outline" />

            <TextView
                android:id="@+id/tv_card_likes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="234"
                android:textSize="10sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <!-- Comment -->
        <LinearLayout
            android:id="@+id/btn_card_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_action_comment_outline" />

            <TextView
                android:id="@+id/tv_card_comments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="45"
                android:textSize="10sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <!-- Share -->
        <ImageButton
            android:id="@+id/btn_card_share"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_action_share"
            app:tint="@color/text_secondary"
            android:contentDescription="分享" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

</LinearLayout>
