<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="我的草稿箱"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_empty_drafts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="这里空空如也，去发一条秘密吧~"
        android:textColor="@color/text_muted"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/ll_draft_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未发布的树洞"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_draft_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="草稿内容..."
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:maxLines="3"
            android:ellipsize="end"/>
            
    </LinearLayout>

    <Button
        android:id="@+id/btn_clear_drafts"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_ghost"
        android:text="清空草稿"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"/>
</LinearLayout>
