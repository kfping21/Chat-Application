<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="欢迎来到树洞"
            android:textColor="@color/gold_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="设置你的昵称和头像"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Avatar Selection -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="32dp">

            <ImageView
                android:id="@+id/iv_avatar_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_circle"
                android:padding="3dp"
                android:src="@drawable/ic_nav_my"
                app:tint="@color/gold_primary" />

            <ImageView
                android:id="@+id/iv_avatar_edit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_fab_golden"
                android:padding="6dp"
                android:src="@drawable/ic_action_edit"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="点击选择头像"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- Preset Avatars -->
        <LinearLayout
            android:id="@+id/ll_preset_avatars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/preset_avatar_1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_avatar_circle"
                android:padding="2dp"
                android:src="@drawable/avatar_preset_1" />

            <ImageView
                android:id="@+id/preset_avatar_2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_avatar_circle"
                android:padding="2dp"
                android:src="@drawable/avatar_preset_2" />

            <ImageView
                android:id="@+id/preset_avatar_3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_avatar_circle"
                android:padding="2dp"
                android:src="@drawable/avatar_preset_3" />

            <ImageView
                android:id="@+id/preset_avatar_4"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_avatar_circle"
                android:padding="2dp"
                android:src="@drawable/avatar_preset_4" />

            <ImageView
                android:id="@+id/preset_avatar_5"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_avatar_circle"
                android:padding="2dp"
                android:src="@drawable/avatar_preset_5" />
        </LinearLayout>

        <!-- Nickname Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="昵称"
            app:boxBackgroundColor="@color/surface_dark"
            app:boxStrokeColor="@color/gold_primary"
            app:hintTextColor="@color/gold_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_nickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLength="20"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="3-20个字符"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- Complete Button -->
        <Button
            android:id="@+id/btn_complete"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_button_golden"
            android:text="完成设置"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
    </ScrollView>

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/progress_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/gold_primary" />
    </FrameLayout>

</FrameLayout>