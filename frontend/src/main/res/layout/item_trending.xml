<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <!-- Rank Number -->
    <TextView
        android:id="@+id/tv_trending_rank"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:text="1"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/gold_primary"
        android:gravity="center"
        android:background="@drawable/bg_avatar_golden"
        android:backgroundTint="#20FFD700"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_trending_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="#失眠夜晚的碎碎念"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_trending_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="近24小时有3,212人参与共鸣"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_bar"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥"
            android:textSize="10sp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/tv_trending_heat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9.8w"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/gold_secondary" />
    </LinearLayout>

</LinearLayout>
