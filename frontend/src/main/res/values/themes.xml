<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.TreeHole" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/gold_primary</item>
        <item name="colorPrimaryVariant">@color/gold_secondary</item>
        <item name="colorOnPrimary">@color/bg_deep</item>
        <item name="colorSecondary">@color/gold_secondary</item>
        <item name="colorSecondaryVariant">@color/gold_dim</item>
        <item name="colorOnSecondary">@color/bg_deep</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_deep</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorError">@color/unread_badge</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.TreeHole" parent="Base.Theme.TreeHole" />

    <!-- Title text style: 24sp, golden, used on ALL page headers -->
    <style name="TextAppearance.TreeHole.Title" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/gold_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Subtitle style: 14sp, muted -->
    <style name="TextAppearance.TreeHole.Subtitle" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Body text -->
    <style name="TextAppearance.TreeHole.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.7</item>
    </style>

    <!-- Caption / timestamp -->
    <style name="TextAppearance.TreeHole.Caption" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- Card style -->
    <style name="Widget.TreeHole.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Golden filled button -->
    <style name="Widget.TreeHole.Button.Golden" parent="">
        <item name="android:background">@drawable/ripple_button_golden</item>
        <item name="android:textColor">@color/bg_deep</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Ghost / muted button -->
    <style name="Widget.TreeHole.Button.Ghost" parent="">
        <item name="android:background">@drawable/ripple_button_ghost</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Chip / tab button -->
    <style name="Widget.TreeHole.Chip" parent="">
        <item name="android:background">@drawable/bg_chip_default</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- Header bar overlay -->
    <style name="Widget.TreeHole.Header" parent="">
        <item name="android:background">@color/bg_header</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:elevation">8dp</item>
    </style>

    <!-- Slide-up animation for bottom sheet -->
    <style name="TreeHole.BottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="colorSurface">@color/bg_card</item>
        <item name="bottomSheetStyle">@style/Widget.TreeHole.BottomSheet</item>
    </style>
    <style name="Widget.TreeHole.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/bg_card</item>
        <item name="shapeAppearance">@style/ShapeAppearance.TreeHole.BottomSheet</item>
    </style>
    <style name="ShapeAppearance.TreeHole.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>
    <!-- Bottom nav label text style (compact) -->
    <style name="TextAppearance.TreeHole.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Bottom nav label active style -->
    <style name="TextAppearance.TreeHole.NavLabel.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/gold_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Transparent active indicator for bottom nav to match Design -->
    <style name="Widget.TreeHole.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- ========== UI Improvements: Unified Page Header Styles ========== -->

    <!-- Unified Page Title style: 18sp, golden, bold, centered -->
    <style name="TextAppearance.TreeHole.PageTitle" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/gold_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Unified Page Subtitle style: 11sp, muted -->
    <style name="TextAppearance.TreeHole.PageSubtitle" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- Unified Page Header container style -->
    <style name="Widget.TreeHole.PageHeader" parent="">
        <item name="android:background">@color/bg_header</item>
        <item name="android:paddingStart">@dimen/page_header_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/page_header_padding_horizontal</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:elevation">8dp</item>
    </style>

</resources>
