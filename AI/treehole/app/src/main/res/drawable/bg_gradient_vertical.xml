<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底层渐变背景：从深蓝黑到略浅的蓝黑色 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/bg_gradient_start"
                android:centerColor="@color/bg_gradient_mid"
                android:endColor="@color/bg_gradient_end"
                android:type="linear" />
        </shape>
    </item>
    <!-- 顶层微光效果 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#0800A5C4"
                android:centerColor="#00000000"
                android:endColor="#08F5C024"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
