<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep"
    android:fitsSystemWindows="true">

    <!-- Unified Page Header with decorative line and tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_header"
        android:paddingStart="@dimen/page_header_padding_horizontal"
        android:paddingEnd="@dimen/page_header_padding_horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:elevation="8dp"
        android:gravity="center_horizontal">

        <!-- Decorative golden line - centered above title -->
        <View
            android:layout_width="@dimen/decor_line_width"
            android:layout_height="@dimen/decor_line_height"
            android:background="@drawable/decor_line_golden"
            android:layout_marginBottom="12dp" />

        <!-- Title: 回响 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_echoes"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/gold_primary"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <!-- Tabs: 评论 / 私聊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:weightSum="2"
            android:background="@drawable/bg_card"
            android:padding="4dp">

            <TextView
                android:id="@+id/btn_tab_comments"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/tab_comments"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_chip_selected"
                android:textColor="@color/gold_primary" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp">

                <TextView
                    android:id="@+id/btn_tab_messages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/tab_messages"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:background="@null"
                    android:textColor="@color/text_muted" />

                <!-- Unread badge -->
                <TextView
                    android:id="@+id/tv_unread_badge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:background="@color/unread_badge"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_echoes"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
