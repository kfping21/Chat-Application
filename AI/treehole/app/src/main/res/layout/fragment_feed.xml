<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep"
    android:fitsSystemWindows="true">

    <!-- Unified Page Header with decorative line -->
    <LinearLayout
        android:id="@+id/header_feed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_header"
        android:paddingStart="@dimen/page_header_padding_horizontal"
        android:paddingEnd="@dimen/page_header_padding_horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:elevation="8dp"
        android:gravity="center_horizontal">

        <!-- Decorative golden line - centered above title -->
        <View
            android:layout_width="@dimen/decor_line_width"
            android:layout_height="@dimen/decor_line_height"
            android:background="@drawable/decor_line_golden"
            android:layout_marginBottom="12dp" />

        <!-- Title: 树洞 -->
        <TextView
            android:id="@+id/tv_feed_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_feed"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/gold_primary"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium" />

        <!-- Subtitle: 听见心声 -->
        <TextView
            android:id="@+id/tv_feed_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitle_feed"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <!-- Feed RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_feed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="80dp"
        android:scrollbars="none" />

</LinearLayout>
