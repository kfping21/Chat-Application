<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep"
    android:gravity="center_horizontal">

    <!-- Top spacing for status bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8" />

    <!-- Logo / App Icon Area -->
    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="16dp">

        <!-- Glow effect -->
        <View
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_fab_glow_layer"
            android:alpha="0.6" />

        <!-- Tree icon placeholder -->
        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_launcher_foreground"
            app:tint="@color/gold_primary" />
    </FrameLayout>

    <!-- App Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/gold_primary"
        android:letterSpacing="0.1"
        android:layout_marginBottom="4dp" />

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="倾听心灵的声音"
        android:textSize="14sp"
        android:textColor="@color/text_muted"
        android:letterSpacing="0.05"
        android:layout_marginBottom="48dp" />

    <!-- Login Form Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_form_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="欢迎回来"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/gold_primary"
            android:layout_marginBottom="24dp" />

        <!-- Username/Email Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="账号"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_username"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="请输入用户名或邮箱"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="text" />
        </LinearLayout>

        <!-- Password Input -->
        <LinearLayout
            android:id="@+id/ll_password_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="密码"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="请输入密码"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="textPassword" />
        </LinearLayout>

        <!-- Confirm Password (Register only) -->
        <LinearLayout
            android:id="@+id/ll_confirm_password_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="确认密码"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="请再次输入密码"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="textPassword" />
        </LinearLayout>

        <!-- Forgot Password -->
        <TextView
            android:id="@+id/tv_forgot_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="忘记密码？"
            android:textSize="12sp"
            android:textColor="@color/gold_secondary"
            android:layout_marginBottom="24dp"
            android:padding="4dp" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="登录"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/bg_deep"
            android:background="@drawable/ripple_button_golden"
            android:layout_marginBottom="16dp" />

        <!-- Divider with text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/border_card" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="或"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/border_card" />
        </LinearLayout>

        <!-- Social Login Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_wechat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_button_ghost"
                android:src="@android:drawable/ic_menu_send"
                android:scaleType="center"
                app:tint="@color/gold_primary"
                android:contentDescription="微信登录" />

            <ImageButton
                android:id="@+id/btn_qq"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_button_ghost"
                android:src="@android:drawable/ic_menu_call"
                android:scaleType="center"
                app:tint="@color/gold_primary"
                android:contentDescription="QQ登录" />

            <ImageButton
                android:id="@+id/btn_phone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_ghost"
                android:src="@android:drawable/ic_menu_call"
                android:scaleType="center"
                app:tint="@color/gold_primary"
                android:contentDescription="手机登录" />
        </LinearLayout>
    </LinearLayout>

    <!-- Toggle Login/Register -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tv_toggle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="还没有账号？"
            android:textSize="14sp"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/tv_toggle_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="立即注册"
            android:textSize="14sp"
            android:textColor="@color/gold_primary"
            android:textStyle="bold"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </LinearLayout>

    <!-- Bottom spacing -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Agreement Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="登录即表示同意《用户协议》和《隐私政策》"
        android:textSize="10sp"
        android:textColor="@color/text_hint"
        android:layout_marginBottom="24dp" />

</LinearLayout>
